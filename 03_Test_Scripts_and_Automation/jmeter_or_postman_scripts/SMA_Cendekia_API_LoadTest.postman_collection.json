            "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/students?search=A&page=1&limit=5"
          }
        },
        {
          "name": "GET /students/99999 - Not Found (EP Invalid)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
            "pm.test('success = false', () => pm.expect(pm.response.json().success).to.be.false);"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/students/99999"
          }
        }
      ]
    },
